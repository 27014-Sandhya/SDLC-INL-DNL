<?xml version='1.0' encoding='UTF-8'?>
<Library LVVersion="26008000">
	<Property Name="NI.Lib.Description" Type="Str">Core.lvlib serves as the central library of the ADC/DAC INL-DNL Measurement Framework and contains the common functionality, reusable components, shared data structures, and utility VIs used throughout the application. The library provides the foundation for instrument configuration, test execution, data processing, result generation, and application-level operations that are shared across multiple measurement workflows.</Property>
